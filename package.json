{
  "type": "module",
  "devDependencies": {
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jquery": "^3.7",
    "npm-run-all": "^4.1.5",
    "sass": "^1.94.0",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "scripts": {
    "buildcss": "sass App/css/main.scss public/main.css --load-path=node_modules",
    "watchcss": "sass --watch App/css/main.scss:public/main.css --load-path=node_modules",
    "buildjs": "webpack",
    "watchjs": "webpack --watch",
    "build": "npm-run-all -p buildcss buildjs",
    "watch": "npm-run-all -p watchcss watchjs",
    "prodjs": "webpack --mode production",
    "prod": "npm-run-all -p buildcss prodjs",
    "serve": "cd public && php -S localhost:8080 && echo 'Server started on http://localhost:8080'",
    "start": "npm-run-all -p watch serve",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --env=jsdom"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  }
}
